# ── Required ────────────────────────────────────────────────────────────────
# API key for OpenRouter (https://openrouter.ai/keys). Used by every review agent.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used by all review agents, in Mastra's `provider/model` format.
# With the OpenRouter provider, MODEL_NAME is the OpenRouter model slug:
#   openrouter/<vendor>/<model>
# Examples:
#   openrouter/anthropic/claude-sonnet-4.5
#   openrouter/openai/gpt-4o-mini
#   openrouter/google/gemini-2.5-pro
MODEL_NAME=openrouter/openai/gpt-4o-mini

# ── Optional integrations ───────────────────────────────────────────────────
# GitHub token (classic or fine-grained, repo scope). Enables private-repo PR
# reviews and posting inline review comments. Public repos work without it.
GITHUB_TOKEN=

# GitLab token (read_api + api to post comments). Enables MR reviews/comments.
GITLAB_TOKEN=
# Self-hosted GitLab instances: set the host used when parsing MR URLs.
GITLAB_HOST=gitlab.com

# ── Optional tuning ─────────────────────────────────────────────────────────
# Where review history is persisted (LibSQL file or turso:// URL).
REVIEW_DB_URL=file:./reviews.db
# Where `git clone` puts repositories cloned from remote URLs.
REPO_CACHE_DIR=.repos
# Where the static review UI is served from.
UI_DIR=./ui
